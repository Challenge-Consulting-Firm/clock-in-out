# 勤怠打刻システム 環境変数サンプル
#   cp .env.sample .env  （.env は .gitignore 済み。実値を書くのでコミット禁止）

# ============================================================================
# AWS 接続先
# ============================================================================
AWS_PROFILE=
# データ所在の前提。東京固定（jp. プロファイルの呼び出し元エンドポイント）
AWS_REGION=ap-northeast-1

# ============================================================================
# Bedrock（国内完結・jp. プロファイル）
# ============================================================================
# 軽量モデル既定。精度不足なら jp.anthropic.claude-sonnet-4-6 に切替。
# コスト配賦するなら `terraform output application_inference_profile_arns` の ARN を指定。
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# ============================================================================
# Microsoft Graph アプリ資格情報（Azure AD アプリ登録で取得）
# ----------------------------------------------------------------------------
# 事前条件:
#   - アプリケーション権限 ChannelMessage.Read.All を付与し「管理者の同意」済みであること
#     （委任(Delegated)ではなくアプリケーション(Application)権限。client credentials フローのため）
# 取得場所（Azure ポータル → アプリの登録 → 対象アプリ）:
#   GRAPH_TENANT_ID     … 「概要」のディレクトリ (テナント) ID
#   GRAPH_CLIENT_ID     … 「概要」のアプリケーション (クライアント) ID
#   GRAPH_CLIENT_SECRET … 「証明書とシークレット」で発行した値（発行直後しか表示されない）
# ============================================================================
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=

# ============================================================================
# 読み取り対象チャネル（Terraform var.channels_json）
# ----------------------------------------------------------------------------
# role は clock（打刻用）/ report（遅刻・有給などの報告用）。
# team_id / channel_id の取得方法:
#   - Teams のチャネル「…」→「チャネルへのリンクを取得」の URL から
#     groupId=<team_id> と channel/<channel_id> を読み取る
#   - または Graph Explorer: GET /me/joinedTeams → GET /teams/{team-id}/channels
# ※ channel_id は "19:xxxxxxxx@thread.tacv2" 形式。JSON 内では URL エンコードせず生値を入れる。
# ============================================================================
GRAPH_TEAM_ID=00000000-0000-0000-0000-000000000000
CLOCK_CHANNEL_ID=19:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@thread.tacv2
REPORT_CHANNEL_ID=19:yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy@thread.tacv2

# Terraform に渡す最終形（上の値を埋めてから使う）:
CHANNELS_JSON='[{"role":"clock","team_id":"<GRAPH_TEAM_ID>","channel_id":"<CLOCK_CHANNEL_ID>","label":"打刻"},{"role":"report","team_id":"<GRAPH_TEAM_ID>","channel_id":"<REPORT_CHANNEL_ID>","label":"報告"}]'

# ============================================================================
# Teams 週次レポート投稿先（Power Automate「Webhook 要求を受信したとき」）
# ----------------------------------------------------------------------------
# 週次サマリの投稿先チャネルに作成したフローの webhook URL。
# ※ 署名(sig)付きの完全な URL を使うこと（不完全だと 401。参考リポジトリの実測）。
# ============================================================================
TEAMS_WEBHOOK_URL=

# ============================================================================
# 起動スケジュール（任意・Terraform 既定を上書きしたい場合）
# ============================================================================
# DAILY_CRON_JST=cron(0 5 * * ? *)      # 毎日 05:00 JST（前日分を確定）
# WEEKLY_CRON_JST=cron(30 9 ? * MON *)  # 毎週月曜 09:30 JST

# ============================================================================
# 投入手順（terraform apply 後。シークレットは state に平文で残さないため CLI で投入）
# ----------------------------------------------------------------------------
# 1) Graph 資格情報（上の GRAPH_* を埋め込む）:
#      aws ssm put-parameter --name /clock-in-out/graph-credentials --type SecureString --overwrite \
#        --value "{\"tenant_id\":\"$GRAPH_TENANT_ID\",\"client_id\":\"$GRAPH_CLIENT_ID\",\"client_secret\":\"$GRAPH_CLIENT_SECRET\"}"
# 2) Teams webhook:
#      aws ssm put-parameter --name /clock-in-out/teams-webhook-url --type SecureString --overwrite \
#        --value "$TEAMS_WEBHOOK_URL"
# ============================================================================
